# Windsurf Logger Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# Local Storage Settings
# ============================================================================
# Log directory (defaults to standard Windsurf data directory)
# WINDSURF_LOG_DIR=/path/to/logs

# ============================================================================
# AWS S3 Storage Configuration
# Uncomment and configure to pull hooks logs from an S3 bucket
# ============================================================================
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_DEFAULT_REGION=us-east-1

# S3 Bucket Settings (can also be configured in the UI)
# WINDSURF_S3_BUCKET=your-logs-bucket
# WINDSURF_S3_PREFIX=logs/windsurf/

# ============================================================================
# Azure Blob Storage Configuration
# Uncomment and configure to pull hooks logs from Azure Blob Storage
# ============================================================================
# AZURE_STORAGE_ACCOUNT_NAME=your_account_name
# AZURE_STORAGE_ACCOUNT_KEY=your_account_key_here
# Or use a connection string instead:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Azure Container Settings (can also be configured in the UI)
# WINDSURF_AZURE_CONTAINER=your-container
# WINDSURF_AZURE_PATH=logs/windsurf/

# ============================================================================
# Logger Settings
# ============================================================================
# WINDSURF_MAX_CONTENT_LENGTH=100000
# WINDSURF_LOG_BUFFER_SIZE=10
# WINDSURF_LOG_FLUSH_INTERVAL=5.0

# Log rotation (Phase 4 / Epic 5):
# Max size of a single .jsonl log file before rotation (default: 50 MB).
# WINDSURF_LOG_MAX_SIZE=52428800
# Number of rotated files to keep (default: 5). Older files are deleted.
# WINDSURF_LOG_MAX_FILES=5
# Retention period (days) for session logs (default: 90). Files older than
# this are deleted by a once-per-day cleanup pass.
# WINDSURF_LOG_RETENTION_DAYS=90

# ============================================================================
# Flask Backend Settings
# ============================================================================
# IMPORTANT: FLASK_HOST defaults to 127.0.0.1 (loopback) for security. Set
# to 0.0.0.0 only when running in a container or behind a reverse proxy
# that authenticates external traffic. The shipped Dockerfile already sets
# FLASK_HOST=0.0.0.0 for in-container use.
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5173
# FLASK_DEBUG=false

# ============================================================================
# Pagination
# ============================================================================
# WINDSURF_PAGE_SIZE=100
# WINDSURF_MAX_PAGE_SIZE=1000

# ============================================================================
# Cache Settings
# ============================================================================
# WINDSURF_CACHE_TTL=60
# WINDSURF_CACHE_MAX_SIZE=100

# ============================================================================
# Security
# ============================================================================
# WINDSURF_RATE_LIMIT=100
# WINDSURF_RATE_LIMIT_WINDOW=60

# CORS_ORIGINS defaults to http://localhost:5173 only. Provide a
# comma-separated list of additional allowed origins for production use.
# WINDSURF_CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# API authentication. When set, all /api/ endpoints require:
#   Authorization: Bearer <WINDSURF_API_KEY>
# If unset, the API is unauthenticated (a warning is logged at startup).
# WINDSURF_API_KEY=replace-me-with-a-long-random-string

# Admin / OS-shell endpoints (/api/config/restart-backend,
# /api/config/reveal-env, /api/config/open-env) are DISABLED by default
# because they spawn OS processes. Set to "true" to enable. Even when
# enabled, they still require Authorization if WINDSURF_API_KEY is set.
# ENABLE_ADMIN_ENDPOINTS=false

# Additional allowed paths for directory browsing (comma-separated).
# Defaults to the repo base dir + the resolved LOG_DIR only.
# WINDSURF_ALLOWED_PATHS=/path/to/dir1,/path/to/dir2
